ENVIRONMENT=development
SENTINELSCAN_API_KEY=sentinelscan-development-key
DATABASE_URL=sqlite:///./data/sentinelscan.db
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
PORT=8001
REQUEST_TIMEOUT_SECONDS=30

